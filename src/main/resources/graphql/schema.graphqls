type Query {
    saveCharacter(characterDAO: inputCharacterDAO): CharacterDAO
    charactersByUserId(userId: String): [CharacterObject]
    characterById(characterId: String): CharacterDAO
    fullCharacterById(characterId: String): CharacterDAO
    createInventoryItem(inventoryItem: inputInventory): InventoryDAO
    getCharacterInventory(characterId: String): [InventoryDAO]
    getCharacterInventoryByType(characterId: String, itemType: String): [InventoryDAO]
    getItemListByType(itemType: String): [Item]
    getWeaponList: [Item]
    getTalentsList: [String]
    getAncestryList: [Ancestry]
    getProficiencyNames(proficiencies: String): [ProficiencyDAO]
    getTalentAndAttributeData(talent1Name: String, talent2Name: String): [TalentDAO]
    calculateState(state: inputCharacterState, character: inputCharacterObject): CalculatedState
    getCharacterStateById(id: String): CharacterState
    addEffect(effectName: String, state: inputCharacterState): CharacterDAO
}

type CharacterObject {
    id: String
    userId: String
    name: String
    attributeLevel: Int
    attribute1: Int
    attribute2: Int
    talent1: String
    talent2: String
    size: String
    ancestryTrait: String
    ancestryName: String
    baseFitness: Int
    basePrecision: Int
    baseFocus: Int
    baseSense: Int
    proficiencies: String
}

input inputCharacterObject {
    id: String
    userId: String
    name: String
    attributeLevel: Int
    attribute1: Int
    attribute2: Int
    talent1: String
    talent2: String
    size: String
    ancestryTrait: String
    ancestryName: String
    baseFitness: Int
    basePrecision: Int
    baseFocus: Int
    baseSense: Int
    proficiencies: String
}

type CharacterState {
    id: String
    characterId: String
    hitPoints: Int
    armor: Int
    manaPoints: Int
    activeEffects: String
    inactiveEffects: String
}

input inputCharacterState {
    id: String
    characterId: String
    hitPoints: Int
    armor: Int
    manaPoints: Int
    activeEffects: String
    inactiveEffects: String
}

type CalculatedState {
    characterId: String 
    hitPointsMax: Int
    hitPoints: Int
    armorMax: Int
    armorMin: Int
    armor: Int
    manaMax: Int
    manaPoints: Int
    spellCapacity: Int
    dexterity: Int
    celerity: Int
    awareness: Int
    subtlety: Int
    evasion: Int
    tenacity: Int
    encumbrance: Int
    fitness: Int
    precision: Int
    focus: Int
    sense: Int
    woundsMax: Int
    wounds: Int
    movement: Int
}

type InventoryDAO {
    inventory: Inventory
    item: Item
}

input inputInventoryDAO {
    inventory: inputInventory
    item: inputItem
}

type Inventory {
    id: String
    characterId: String
    itemId: String
    equipped: Boolean
    proficiency: Int
    quantity: Int
}

input inputInventory {
    id: String
    characterId: String
    itemId: String
    equipped: Boolean
    quantity: Int
}

type Item {
    id: String
    name: String
    itemType: String
    subtype: String
    equippable: Boolean
    size: String
    weight: Float
    description: String
    properties: String
    attack1String: String
    attack2String: String
    effectName: String
    baseCost: Int
    rarity: String
}

input inputItem {
    id: String
    name: String
    itemType: String
    subtype: String
    equippable: Boolean
    size: String
    weight: Float
    description: String
    properties: String
    attack1String: String
    attack2String: String
    effectName: String
    baseCost: Int
    rarity: String
}

type Effect {
    id: String
    name: String
    description: String
    charProperty: String
    effectType: Int
    conditionalCheck: String
    effect: String
}

type Attribute {
    id: String
    name: String
    talentName: String
    flag: Int
    description: String
}

type Ancestry {
    id: String
    name: String
    source: String
    trait: String
    size: String
}

type Talent {
    id: String
    name: String
    ability1: String
    ability2: String
    description: String
    hpBonus: Int
    prioritySkills: String
    role: String
    complexity: Int
    keystone: String
    capstone: String
    caster: Boolean
}

type CharacterDAO {
    inventory: [InventoryDAO]
    character: CharacterObject
    attributes: [Attribute]
    talents: [Talent]
    proficiencies: [ProficiencyDAO]
    characterState: CharacterState
    calculatedState: CalculatedState
}

input inputCharacterDAO {
    inventory: [inputInventoryDAO]
    character: inputCharacterObject
    characterState: inputCharacterState
}

type ProficiencyDAO {
    item: Item
    mastery: Boolean
}

type TalentDAO { 
    talent: Talent
    attributes: [Attribute]
}

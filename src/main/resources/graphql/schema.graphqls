type Query {
    saveCharacter(characterDAO: inputCharacterDAO): CharacterDAO
    charactersByUserId(userId: String): [CharacterObject]
    fullCharacterById(characterId: String): CharacterDAO
    getCharacterInventory(characterId: String): [InventoryDAO]
    getItemListByType(itemType: String): [Item]
    getTalentScreen: TalentScreen
    getAttributeList: [Attribute]
    getBackgroundScreen(source:String): BackgroundScreen
    getCharacterStateById(id: String): CharacterState
    getFilteredSpells(sources: [String]): [Spell]
    createGame(ownerId: String): Game
    saveGame(game: inputGame): Game
    getGameById(gameId:String): GameDAO
    getEquipmentScreen(characterId: String): EquipmentScreen
    getEffectList: [Effect]
}

type Mutation {
    addEffect(effectName: String, state: inputCharacterState): CharacterDAO
    addCharactersToGame(gameId:String, characterId: String): Game
    changeGameOwner(gameId: String, userId: String): Game
    RemoveCharacterFromGame(gameId: String, characterId: String): GameDAO
    modifyPartyInventoryItem(inventoryItem: inputPartyInventory): PartyInventory
    saveSpellCharacter(characterSpells: [inputSpellCharacter]): Int 
    changeItemOwner(inventoryItem: inputInventory, newOwnerId: String, transferQuantity: Int): Int
    deleteCharacter(characterId: String): Boolean
}

type CharacterObject {
    id: String
    userId: String
    name: String
    attributeLevel: Int
    talent1: Talent
    talent2: Talent
    attributes1: [Attribute]
    attributes2: [Attribute]
    ancestry: AncestryInner
    background: BackgroundInner
    baseFitness: Int
    basePrecision: Int
    baseFocus: Int
    baseSense: Int
    size: String
    proficiencies: [String]
    state: CharacterState
    patronDamageType: String
    elementDamageType: String
    elementName: String
}

input inputCharacterObject {
    id: String
    userId: String
    name: String
    attributeLevel: Int
    talent1: inputTalent
    talent2: inputTalent
    attributes1: [inputAttribute]
    attributes2: [inputAttribute]
    ancestry: inputAncestryInner
    background: inputBackgroundInner
    baseFitness: Int
    basePrecision: Int
    baseFocus: Int
    baseSense: Int
    size: String
    proficiencies: [String]
    state: inputCharacterState
    patronDamageType: String
    elementDamageType: String
    elementName: String
}

type CharacterState {
    hitPoints: Int
    armor: Int
    wounds: Int
    manaPoints: Int
    activeEffects: [Effect]
    inactiveEffects: [Effect]
}

input inputCharacterState {
    hitPoints: Int
    armor: Int
    wounds: Int
    manaPoints: Int
    activeEffects: [inputEffect]
    inactiveEffects: [inputEffect]
}

type Effect {
    id: String
    name: String
    description: String
    charProperty: String
    effectType: Int
    conditionalCheck: String
    effect: String
}
input inputEffect {
    id: String
    name: String
    description: String
    charProperty: String
    effectType: Int
    conditionalCheck: String
    effect: String
}

type CalculatedState {
    characterId: String 
    hitPointsMax: Int
    hitPoints: Int
    armorMax: Int
    armorMin: Int
    armor: Int
    manaMax: Int
    manaPoints: Int
    spellCapacity: Int
    dexterity: Int
    celerity: Int
    awareness: Int
    subtlety: Int
    evasion: Int
    tenacity: Int
    encumbrance: Int
    fitness: Int
    precision: Int
    focus: Int
    sense: Int
    woundsMax: Int
    wounds: Int
    movement: Int
}

type Spell {
    id: String
    name: String
    spellType: String
    source: String
    actionCost: String
    manaCost: Int
    range: String
    duration: String
    description: String
    effectAmount: String
    effectConditional: String
    effectType: String
    tags: String
}

input inputSpell {
    id: String
    name: String
    spellType: String
    source: String
    actionCost: String
    manaCost: Int
    range: String
    duration: String
    description: String
    effectAmount: String
    effectConditional: String
    effectType: String
    tags: String
}

type SpellCharacter {
    id: String
    characterId: String
    spellId: String
}

input inputSpellCharacter {
    id: String
    characterId: String
    spellId: String
}

type Inventory {
    id: String
    characterId: String
    itemId: String
    equipped: Boolean
    proficiency: Int
    quantity: Int
}

input inputInventory {
    id: String
    characterId: String
    itemId: String
    equipped: Boolean
    quantity: Int
}

type Item {
    id: String
    name: String
    itemType: String
    subtype: String
    equippable: Boolean
    size: String
    weight: Float
    description: String
    properties: String
    attack: Attack
    special: Special
    effectName: String
    baseCost: Int
    rarity: String
}

input inputItem {
    id: String
    name: String
    itemType: String
    subtype: String
    equippable: Boolean
    size: String
    weight: Float
    attack: inputAttack
    special: inputSpecial
    description: String
    properties: String
    effectName: String
    baseCost: Int
    rarity: String
}

type Attack {
    name: String
    action: Int
    range: String
    damage: String
    damageType: String
}

type Special {
    name: String
    action: Int
    description: String
}

input inputAttack {
    name: String
    action: Int
    range: String
    damage: String
    damageType: String
}

input inputSpecial {
    name: String
    action: Int
    description: String
}


type Pack {
    id: String
    name: String
    background: String
    currency: Int
    rations: Int
    salves: Int
    reagents: String
    materials: String
    innerwear: String
    outerwear: String
    items: String
}

type Attribute {
    id: String
    name: String
    talentName: String
    description1: String
    description2: String
}

input inputAttribute {
    id: String
    name: String
    talentName: String
    description1: String
    description2: String
}

type Ancestry {
    id: String
    name: String
    parent: String
    source: String
    trait1: String
    trait2: String
    size: String
    description: String
}

type AncestryInner {
    id: String
    name: String
    parent: String
    source: String
    trait1: Trait
    trait2: Trait
    size: String
    description: String
}

input inputAncestryInner {
    id: String
    name: String
    parent: String
    source: String
    trait1: inputTrait
    trait2: inputTrait
    size: String
    description: String
}

type Trait {
    id: String
    name: String
    traitType: String
    description: String
    tags: String
}

input inputTrait {
    id: String
    name: String
    traitType: String
    description: String
    tags: String
}

type Background {
    id: String
    name: String
    source: String
    parentTrait: String
    childTrait: String
    deity: String
    description: String
    tags: String
}

type BackgroundInner {
    id: String
    name: String
    source: String
    parentTrait: Trait
    childTrait: Trait
    deity: String
    description: String
    tags: String
}

input inputBackgroundInner {
    id: String
    name: String
    source: String
    parentTrait: inputTrait
    childTrait: inputTrait
    deity: String
    description: String
    tags: String
}

type Talent {
    id: String
    name: String
    ability1: String
    ability2: String
    description: String
    hpBonus: Int
    prioritySkills: String
    role: String
    complexity: Int
    keystone: String
    capstone: String
    caster: Boolean
}

input inputTalent {
    id: String
    name: String
    ability1: String
    ability2: String
    description: String
    hpBonus: Int
    prioritySkills: String
    role: String
    complexity: Int
    keystone: String
    capstone: String
    caster: Boolean
}

type Game {
    id: String
    ownerId: String
    characterIds: String
    playerIds: String
    joinCode: String
}

input inputGame {
    id: String
    ownerId: String
    characterIds: String
    playerIds: String
    joinCode: String
}

type PartyInventory {
    id: String
    gameId: String
    itemId: String
    location: String
}

input inputPartyInventory {
    id: String
    gameId: String
    itemId: String
    location: String
}

type GameDAO {
    game: Game
    characters: [CharacterObject]
    partyInventory: [PartyInventory]
}

type CharacterDAO {
    inventory: [InventoryDAO]
    character: CharacterObject
    calculatedState: CalculatedState
    spells: [SpellDAO]
    traitData: TraitDAO
}

input inputCharacterDAO {
    inventory: [inputInventoryDAO]
    character: inputCharacterObject
    spells: [inputSpellDAO]
}

type ProficiencyDAO {
    item: Item
    mastery: Boolean
}

type TalentScreen { 
    talents: [Talent]
    effects: [Effect]
}

type SpellDAO{
    spell: Spell
    spellCharacter: SpellCharacter
}

input inputSpellDAO{
    spell: inputSpell
    spellCharacter: inputSpellCharacter
}

type InventoryDAO {
    inventory: Inventory
    item: Item
}

input inputInventoryDAO {
    inventory: inputInventory
    item: inputItem
}

type TraitDAO {
    ancestry: Ancestry
    background: Background
    traits: [Trait]
}

type BackgroundScreen {
    ancestries: [Ancestry]
    backgrounds: [Background]
    traits: [Trait]
    effects: [Effect]
}

type EquipmentScreen {
    inventory: [Inventory]
    items: [Item]
    packs: [Pack]
}

type Query {
    createCharacter(character: inputCharacter): Character
}

type Character {
    name: String
    aspectLevel: Int
    aspects1: Int
    aspects2: Int
    specialty1: Int
    specialty2: Int
    ancestryTrait: Int
    ancestryName: String
    accountId: ID
    baseFitness: Int
    baseTechnique: Int
    baseFocus: Int
    baseSense: Int
    gold: Int
    silver: Int
    copper: Int
}

input inputCharacter {
    name: String
    aspectLevel: Int
    aspects1: Int
    aspects2: Int
    specialty1: Int
    specialty2: Int
    ancestryTrait: Int
    ancestryName: String
    accountId: ID
    baseFitness: Int
    baseTechnique: Int
    baseFocus: Int
    baseSense: Int
    gold: Int
    silver: Int
    copper: Int
}
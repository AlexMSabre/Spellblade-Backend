type Query {
    createCharacter(characterDAO: inputCharacterDAO): CharacterDAO
    createOrLoginUser(userDAO: inputUserDAO): UserDAO
}

type CharacterDAO {
    id: String
    accountId: String
    name: String
    aspectLevel: Int
    aspects1: Int
    aspects2: Int
    specialty1: Int
    specialty2: Int
    ancestryTrait: Int
    ancestryName: String
    baseFitness: Int
    baseTechnique: Int
    baseFocus: Int
    baseSense: Int
    gold: Int
    silver: Int
    copper: Int
}

input inputCharacterDAO {
    id: String
    accountId: String
    name: String
    aspectLevel: Int
    aspects1: Int
    aspects2: Int
    specialty1: Int
    specialty2: Int
    ancestryTrait: Int
    ancestryName: String
    baseFitness: Int
    baseTechnique: Int
    baseFocus: Int
    baseSense: Int
    gold: Int
    silver: Int
    copper: Int
}

type UserDAO {
    id: String
    username: String
    email: String
}

input inputUserDAO {
    id: String
    username: String
    email: String
}
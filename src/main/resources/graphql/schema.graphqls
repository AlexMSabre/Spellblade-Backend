type Query {
    saveCharacter(characterDAO: inputCharacterDAO): CharacterDAO
    charactersByUserId(userId: String): [CharacterObject]
    createInventoryItem(inventoryItem: inputInventory): InventoryDAO
    getCharacterInventory(characterId: String): [InventoryDAO]
    getCharacterInventoryByType(characterId: String, itemType: String): [InventoryDAO]
    getItemListByType(itemType: String): [Item]
    getWeaponList: [Item]
}

type CharacterObject {
    id: String
    userId: String
    name: String
    aspectLevel: Int
    aspects1: Int
    aspects2: Int
    specialty1: Int
    specialty2: Int
    ancestryTrait: Int
    ancestryName: String
    baseFitness: Int
    baseTechnique: Int
    baseFocus: Int
    baseSense: Int
    proficiencies: String
    gold: Int
    silver: Int
    copper: Int
}

input inputCharacterObject {
    id: String
    userId: String
    name: String
    aspectLevel: Int
    aspects1: Int
    aspects2: Int
    specialty1: Int
    specialty2: Int
    ancestryTrait: Int
    ancestryName: String
    baseFitness: Int
    baseTechnique: Int
    baseFocus: Int
    baseSense: Int
    proficiencies: String
    gold: Int
    silver: Int
    copper: Int
}

type InventoryDAO {
    inventory: Inventory
    item: Item
}

input inputInventoryDAO {
    inventory: inputInventory
    item: inputItem
}

type Inventory {
    id: String
    characterId: String
    itemId: String
    equipped: Boolean
    proficiency: Int
    quantity: Int
}

input inputInventory {
    id: String
    characterId: String
    itemId: String
    equipped: Boolean
    proficiency: Int
    quantity: Int
}

type Item {
    id: String
    name: String
    itemType: String
    subtype: String
    equippable: Boolean
    size: String
    weight: Float
    description1: String
    description2: String
    description3: String
    attack1String: String
    attack2String: String
    attack3String: String
    effectId: String
    baseCost: Int
    rarity: String
}

input inputItem {
    id: String
    name: String
    itemType: String
    subtype: String
    equippable: Boolean
    size: String
    weight: Float
    description1: String
    description2: String
    description3: String
    attack1String: String
    attack2String: String
    attack3String: String
    effectId: String
    baseCost: Int
    rarity: String
}

type CharacterDAO {
    inventory: [InventoryDAO]
    character: CharacterObject
}

input inputCharacterDAO {
    inventory: [inputInventoryDAO]
    character: inputCharacterObject
}

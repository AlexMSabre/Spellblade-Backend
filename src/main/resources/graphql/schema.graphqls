type Query {
    createCharacter(characterDAO: inputCharacterDAO): CharacterDAO
    charactersByAccId(userId: String): [CharacterDAO]
}

type CharacterDAO {
    id: String
    userId: String
    name: String
    aspectLevel: Int
    aspects1: Int
    aspects2: Int
    specialty1: Int
    specialty2: Int
    ancestryTrait: Int
    ancestryName: String
    baseFitness: Int
    baseTechnique: Int
    baseFocus: Int
    baseSense: Int
    gold: Int
    silver: Int
    copper: Int
}

type CharacterList {
    characters: [CharacterDAO]
}

input inputCharacterDAO {
    id: String
    userId: String
    name: String
    aspectLevel: Int
    aspects1: Int
    aspects2: Int
    specialty1: Int
    specialty2: Int
    ancestryTrait: Int
    ancestryName: String
    baseFitness: Int
    baseTechnique: Int
    baseFocus: Int
    baseSense: Int
    gold: Int
    silver: Int
    copper: Int
}

type UserDAO {
    id: String
    username: String
    email: String
}

input inputUserDAO {
    id: String
    username: String
    email: String
}